# Rust Lab (experimental, docs/RUST_LAB.md). Cross-origin isolation is completed only here: /*
# already sends COOP same-origin, and COEP is added for the lab alone, because the in-browser rustc
# needs SharedArrayBuffer and COEP site-wide would block Clerk and CheerpJ. Do not repeat COOP:
# Netlify joins a header named by two matching rules, and "same-origin, same-origin" is invalid.
# The /* CSP still applies too, so the browser enforces both CSPs (the stricter result).
/labs/rust/*
  Cross-Origin-Embedder-Policy: require-corp
  Content-Security-Policy: default-src 'self'; base-uri 'none'; object-src 'none'; frame-ancestors 'none'; form-action 'none'; img-src 'self' data:; font-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self' 'wasm-unsafe-eval'; worker-src 'self'; connect-src 'self'; frame-src 'none';

# Lab workers must carry COEP themselves to share memory with the isolated page.
/assets/rustLabToolchain.worker-*.js
  Cross-Origin-Embedder-Policy: require-corp
  Content-Security-Policy: default-src 'none'; script-src 'self' 'wasm-unsafe-eval'; worker-src 'self'; connect-src 'self';

