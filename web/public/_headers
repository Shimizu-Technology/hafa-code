# Every file under /assets/ is named by its content: Vite adds a content hash to each
# chunk, worker, stylesheet, and asset, and Pyodide lives in a directory named after the
# hash of its files. A changed file gets a new URL, so browsers can keep these for a year
# without asking again. scripts/verify-production-build.mjs fails the build if an
# unhashed file lands here. index.html, sw.js, the manifest, and other public files keep
# revalidating so a deploy is seen on the next visit.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

/sw.js
  Cache-Control: no-cache

# Font file names carry the Fontsource version, so a new version is a new URL.
/fonts/*.woff2
  Cache-Control: public, max-age=31536000, immutable
